{
  "name": "dsh-tool-gate",
  "version": "0.1.0",
  "description": "把 browser / wincu / ig5 这类整包工具从当前会话的工具表里摘掉，要用时一条命令挂回来。只为让每轮固定开销变小，不往 system prompt 写一个字。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tools",
    "context",
    "token",
    "restrict"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7gzgn/dsh-tool-gate.git"
  },
  "homepage": "https://github.com/7gzgn/dsh-tool-gate#readme",
  "bugs": {
    "url": "https://github.com/7gzgn/dsh-tool-gate/issues"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0"
  }
}
